PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_LIPP_REDIRECT=http://127.0.0.1:3000/api/auth/paypal/callback
DATABASE_URL=postgres://postgres:postgres@localhost:5432/landfall
GROQ_API_KEY=
WATCH_OFFICER_MODEL=openai/gpt-oss-20b
NEXT_PUBLIC_AG_STUDIO_LICENSE=
NWS_USER_AGENT="Landfall hackathon app (contact: contact@landfall.local)"
# Required. Generate a long random value (e.g. `openssl rand -hex 32`); the cron route refuses requests when unset.
CRON_SECRET=
JUDGE_MODE_ENABLED=true
APP_URL=http://127.0.0.1:3000
SANDBOX_RESIDENT_EMAIL=
# Demo-only: allow the Households page to decrypt resident names/addresses (server-side switch; default off)
PII_DECRYPT_ENABLED=false
# AG Grid Enterprise licence key (falls back to the AG Studio key if unset). Never commit real keys.
NEXT_PUBLIC_AG_GRID_LICENSE=
# Payout status refresh: POST /api/payouts/refresh does a read-only GET to PayPal for batches Landfall recorded. false disables it.
PAYOUT_REFRESH_ENABLED=true
# Signs session cookies (generate: openssl rand -hex 32). Required in production.
SESSION_SECRET=
# WebAuthn relying party: the exact host users open (no scheme), and the full origin.
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000
# Groq models (available on the free key; llama-3.x chat models are NOT available).
GROQ_MODEL_REASONING=openai/gpt-oss-120b
GROQ_MODEL_FAST=openai/gpt-oss-20b
GROQ_MODEL_GUARD=meta-llama/llama-prompt-guard-2-86m
GROQ_MODEL_SAFEGUARD=openai/gpt-oss-safeguard-20b
GROQ_MODEL_STT=whisper-large-v3-turbo
# Number of reverse proxies in front of the app (X-Forwarded-For is read from the right). Or set TRUSTED_IP_HEADER.
TRUSTED_PROXY_HOPS=1
